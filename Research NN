import torch
import torch.nn as nn
import torch.optim as optim
from torchvision import datasets, transforms
from torch.utils.data import DataLoader
import numpy as np


# Device (CPU or GPU)
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# Load MNIST data (28x28 grayscale images)
transform = transforms.ToTensor()

# Fix for half in train and half in test
train_data = datasets.MNIST(root='./data', train=True, download=True, transform=transform)
test_data = datasets.MNIST(root='./data', train=False, download=True, transform=transform)
train_loader = DataLoader(train_data, batch_size=64, shuffle=True)
test_loader = DataLoader(test_data, batch_size=1000)

# Define 3 layer neural network 
class SimpleNN(nn.Module):
    def __init__(self):
        super(SimpleNN, self).__init__()
        self.fc1 = nn.Linear(28*28, 128)  # First layer (input -> hidden)
        self.fc2 = nn.Linear(128, 10)     # Second layer (hidden -> output)
        self.relu = nn.ReLU()

        # Here, the biases are randomly generated
        self.fc1.bias.data = torch.randn_like(self.fc1.bias) / torch.sqrt(torch.tensor(self.fc1.in_features, dtype=torch.float))
        self.fc2.bias.data = torch.randn_like(self.fc2.bias) / torch.sqrt(torch.tensor(self.fc2.in_features, dtype=torch.float))

        # The other NN generates the weigths from data. With these lines it would do the same. Otherwise, it would be generated by pytorch.
        # self.fc1.weight.data = torch.from_numpy(np.loadtxt('S_Layer1Adjusted', dtype=float))
        # self.fc2.weight.data = torch.from_numpy(np.loadtxt('S_Layer2Adjusted', dtype=float))

    def forward(self, x):
        x = x.view(-1, 28*28)  # Flatten image
        x = self.relu(self.fc1(x))
        x = self.fc2(x)  # No activation here (logits)
        return x

# Initialize model, loss, optimizer
model = SimpleNN().to(device)
criterion = nn.CrossEntropyLoss()
optimizer = optim.SGD(model.parameters(), lr=0.01)

# Training loop
for epoch in range(10):  # of epochs
    model.train()
    total_loss = 0
    for images, labels in train_loader:
        images, labels = images.to(device), labels.to(device)

        # Forward pass
        outputs = model(images)
        loss = criterion(outputs, labels)

        # Backward pass (this is where backprop happens)
        optimizer.zero_grad()
        loss.backward()
        optimizer.step()

        total_loss += loss.item()

    print(f"Epoch {epoch+1}, Loss: {total_loss:.4f}")

# Evaluate on test data
model.eval()
correct = 0
total = 0
with torch.no_grad():
    for images, labels in test_loader:
        images, labels = images.to(device), labels.to(device)
        outputs = model(images)
        _, predicted = torch.max(outputs.data, 1)
        total += labels.size(0)
        correct += (predicted == labels).sum().item()

print(f"Test Accuracy: {100 * correct / total:.2f}%")
