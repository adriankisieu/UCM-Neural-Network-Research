import numpy as np, torch, torch.nn as nn, torch.nn.functional as F, torch.optim as optim, h5py, matplotlib.pyplot as plt
from torch.utils.data import TensorDataset, DataLoader, random_split
from numpy import loadtxt

# ------- Config -------
RUNS = 16
EPOCHS = 50
BATCH_SIZE = 600
EPOCH_START, EPOCH_END = 15, 50
dev = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# ------- Model -------
class Net(nn.Module):
    def __init__(self):
        super().__init__()
        self.fc1, self.fc2 = nn.Linear(28*28,500), nn.Linear(500,10)
    def forward(self,x):
        x = x.view(-1,28*28)
        return self.fc2(F.relu(self.fc1(x)))

# ------- Helpers (CCC) -------
def nearest_rows(values, table):
    sidx = np.argsort(table[:,0]); B, T = table[sidx,0], table[sidx,:]
    pos = np.clip(np.searchsorted(B,values),1,len(B)-1)
    left, right = pos-1, pos
    choose = (np.abs(B[right]-values)<np.abs(B[left]-values))
    return T[np.where(choose,right,left)]

def build_table_layer1(d2,d3):
    diff=d2[:,None]-d3[None,:]
    B=(((diff+0.000278)/0.000556)*0.732311311)-0.467950546463868
    i,j=np.meshgrid(np.arange(len(d2)),np.arange(len(d3)),indexing='ij')
    return np.column_stack([B.ravel(),d2[i].ravel(),d3[j].ravel()])

def build_table_layer2(d2,d3):
    diff=d2[:,None]-d3[None,:]
    B=(((diff+0.000278)/0.000556)*2.006037209594910)-1.014050806418950
    i,j=np.meshgrid(np.arange(len(d2)),np.arange(len(d3)),indexing='ij')
    return np.column_stack([B.ravel(),d2[i].ravel(),d3[j].ravel()])

# ------- One run -------
def run_once(bs):
    f = h5py.File('/Users/adikisieu/Downloads/MNISTdata.hdf5','r')
    x_train,y_train=np.float32(f['x_train'][:]),np.int64(f['y_train'][:,0])
    x_test,y_test=np.float32(f['x_test'][:]),np.int64(f['y_test'][:,0]); f.close()

    x_all,y_all=torch.tensor(np.concatenate([x_train,x_test])).reshape(-1,1,28,28),torch.tensor(np.concatenate([y_train,y_test]))
    full_ds=TensorDataset(x_all,y_all)
    train_ds,test_ds=random_split(full_ds,[int(0.8*len(full_ds)), len(full_ds)-int(0.8*len(full_ds))])
    train_loader=DataLoader(train_ds,batch_size=bs,shuffle=True)
    x_test,y_test=zip(*test_ds); x_test,y_test=torch.stack(x_test).to(dev),torch.tensor(y_test).to(dev)

    d2=loadtxt('New Conductance.txt',dtype=float); d3=loadtxt('New Conductance.txt',dtype=float)
    t1,t2=build_table_layer1(d2,d3),build_table_layer2(d2,d3)

    model=Net().to(dev)
    crit, opt = nn.CrossEntropyLoss(reduction='sum'), optim.SGD(model.parameters(),lr=0.001)

    base_losses, base_accs, adj_losses, adj_accs = [], [], [], []

    for epoch in range(1,EPOCHS+1):
        # ---- Train baseline ----
        model.train()
        for xb,yb in train_loader:
            xb,yb=xb.to(dev),yb.to(dev)
            opt.zero_grad(); loss=crit(model(xb),yb); loss.backward(); opt.step()

        # ---- Evaluate baseline ----
        model.eval()
        with torch.no_grad():
            out=model(x_test)
            base_acc=(out.argmax(1)==y_test).float().mean().item()
            base_loss=crit(out,y_test).item()

        # ---- Apply CCC ----
        fc1=model.fc1.weight.detach().cpu().numpy()
        fc2=model.fc2.weight.detach().cpu().numpy()
        D1=nearest_rows(fc1.ravel(),t1)[:,0].reshape(500,784)
        D2=nearest_rows(fc2.ravel(),t2)[:,0].reshape(10,500)

        adjusted=Net().to(dev)
        adjusted.fc1.weight.data=torch.tensor(D1,dtype=torch.float32,device=dev)
        adjusted.fc2.weight.data=torch.tensor(D2,dtype=torch.float32,device=dev)
        adjusted.fc1.bias.data.zero_(); adjusted.fc2.bias.data.zero_()

        adjusted.eval()
        with torch.no_grad():
            out_adj=adjusted(x_test)
            adj_acc=(out_adj.argmax(1)==y_test).float().mean().item()
            adj_loss=crit(out_adj,y_test).item()

        base_losses.append(base_loss); base_accs.append(base_acc)
        adj_losses.append(adj_loss); adj_accs.append(adj_acc)
        print(f"Epoch {epoch:02d} | Base loss={base_loss:.2f} acc={base_acc:.4f} | Adjusted loss={adj_loss:.2f} acc={adj_acc:.4f}")

    return np.array(base_losses), np.array(base_accs), np.array(adj_losses), np.array(adj_accs)

# ------- Main -------
def main():
    all_base_losses, all_base_accs, all_adj_losses, all_adj_accs = [], [], [], []
    for run in range(RUNS):
        print(f"\n--- Run {run+1} ---")
        bL, bA, aL, aA = run_once(BATCH_SIZE)
        all_base_losses.append(bL); all_base_accs.append(bA)
        all_adj_losses.append(aL); all_adj_accs.append(aA)

    epochs = np.arange(EPOCH_START, EPOCH_END+1)

    # --- Base Loss ---
    plt.figure()
    for i in range(RUNS):
        plt.plot(epochs, all_base_losses[i][EPOCH_START-1:EPOCH_END], label=f'Run {i+1}')
    plt.xlabel('Epoch'); plt.ylabel('Loss'); plt.title('Baseline Loss')
    plt.ylim(700, 1400)
    plt.legend(); plt.savefig('base_loss_zoomed.png', dpi=300, bbox_inches='tight'); plt.show(); plt.close()

    # --- Base Accuracy ---
    plt.figure()
    for i in range(RUNS):
        plt.plot(epochs, all_base_accs[i][EPOCH_START-1:EPOCH_END], label=f'Run {i+1}')
    plt.xlabel('Epoch'); plt.ylabel('Accuracy'); plt.title('Baseline Accuracy')
    plt.ylim(0.968, 0.984)
    plt.legend(); plt.savefig('base_acc_zoomed.png', dpi=300, bbox_inches='tight'); plt.show(); plt.close()

    # --- Adjusted Loss ---
    plt.figure()
    for i in range(RUNS):
        plt.plot(epochs, all_adj_losses[i][EPOCH_START-1:EPOCH_END], label=f'Run {i+1}')
    plt.xlabel('Epoch'); plt.ylabel('Loss'); plt.title('Adjusted Loss')
    plt.ylim(700, 1400)
    plt.legend(); plt.savefig('adj_loss_zoomed.png', dpi=300, bbox_inches='tight'); plt.show(); plt.close()

    # --- Adjusted Accuracy ---
    plt.figure()
    for i in range(RUNS):
        plt.plot(epochs, all_adj_accs[i][EPOCH_START-1:EPOCH_END], label=f'Run {i+1}')
    plt.xlabel('Epoch'); plt.ylabel('Accuracy'); plt.title('Adjusted Accuracy')
    plt.ylim(0.968, 0.984)
    plt.legend(); plt.savefig('adj_acc_zoomed.png', dpi=300, bbox_inches='tight'); plt.show(); plt.close()

    print("\n✅ Done. Four zoomed & scaled graphs (epochs 15–50) generated.")

if __name__ == "__main__":
    main()
