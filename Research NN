import torch
import torch.nn as nn
import torch.optim as optim
from torchvision import datasets, transforms
from torch.utils.data import DataLoader, TensorDataset
import numpy as np
import h5py

# Device (CPU or GPU)
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# Load MNIST data (28x28 grayscale images)
transform = transforms.ToTensor() # Normalizes to 0 to 1

MNIST_data = h5py.File('/Users/adikisieu/Downloads/MNISTdata.hdf5', 'r')
x_train = np.float32(MNIST_data['x_train'][:]) # Converts training data into numpy array. float 32 is the numpy array
y_train = np.int64(np.array(MNIST_data['y_train'][:, 0])) # Puts target values "labels" into int64 numpy array
x_test = np.float32(MNIST_data['x_test'][:]) 
y_test = np.int64(np.array(MNIST_data['y_test'][:, 0])) 
MNIST_data.close() # Closes file

# Convert to PyTorch tensors and reshape
x_train_tensor = torch.tensor(x_train).reshape(-1, 1, 28, 28) 
# Torch.tensor(x_train) Converts the x_train array into a PyTorch tensor. (batch_size, channels, height, width) -1 means figure it out
y_train_tensor = torch.tensor(y_train) # Converts y_train array into a PyTorch tensor
x_test_tensor = torch.tensor(x_test).reshape(-1, 1, 28, 28)
y_test_tensor = torch.tensor(y_test)

# Create datasets and loaders
train_data = TensorDataset(x_train_tensor, y_train_tensor) # This creates a dataset by pairing x_train_tensor and y_train_tensor together
test_data = TensorDataset(x_test_tensor, y_test_tensor)
train_loader = DataLoader(train_data, batch_size=64, shuffle=True)
test_loader = DataLoader(test_data, batch_size=10000)

# Define 3-layer neural network 
class SimpleNN(nn.Module):
    def __init__(self):
        super(SimpleNN, self).__init__()
        self.fc1 = nn.Linear(28*28, 128)  # First layer (input -> hidden)
        self.fc2 = nn.Linear(128, 10)     # Second layer (hidden -> output)
        self.relu = nn.ReLU()

        # Weight initialization 
        self.fc1.weight.data = torch.randn_like(self.fc1.weight) / torch.sqrt(torch.tensor(self.fc1.in_features, dtype=torch.float))
# The weights of the first layer torch.randn_like(self.fc1.weight): Generates a tensor of the same shape as (like) self.fc1.weight. Divides the generated random weights by the square root of the number of input features
        self.fc2.weight.data = torch.randn_like(self.fc2.weight) / torch.sqrt(torch.tensor(self.fc2.in_features, dtype=torch.float))

        # Bias initialization 
        self.fc1.bias.data = torch.randn_like(self.fc1.bias) / torch.sqrt(torch.tensor(self.fc1.in_features, dtype=torch.float))
        self.fc2.bias.data = torch.randn_like(self.fc2.bias) / torch.sqrt(torch.tensor(self.fc2.in_features, dtype=torch.float))

    def forward(self, x):
        x = x.view(-1, 28*28)  # Flatten image
        x = self.relu(self.fc1(x))
        x = self.fc2(x)  # No activation here (logits)
        return x

    def softmax(self, x):
        return torch.exp(x) / torch.sum(torch.exp(x), dim=1, keepdim=True)

    def cross_entropy_error(self, output, target):
        return torch.mean(-torch.log(output.gather(1, target.view(-1, 1))))

# Initialize model, loss, optimizer
model = SimpleNN().to(device)
optimizer = optim.SGD(model.parameters(), lr=0.01)

# Training loop
for epoch in range(5):  # of epochs
    total_loss = 0
    for images, labels in train_loader:
        images, labels = images.to(device), labels.to(device)

        # Forward pass
        outputs = model(images)
        output_softmax = model.softmax(outputs)  # Apply Softmax here
        loss = model.cross_entropy_error(output_softmax, labels)  # Compute loss manually

        # Backward pass (this is where backprop happens)
        optimizer.zero_grad()
        loss.backward()
        optimizer.step()

        total_loss += loss.item()

    print(f"Epoch {epoch+1}, Loss: {total_loss:.4f}")

# Evaluate on test data
correct = 0
total = 0
with torch.no_grad():
    for images, labels in test_loader:
        images, labels = images.to(device), labels.to(device)
        outputs = model(images)
        output_softmax = model.softmax(outputs)  # Apply Softmax here
        _, predicted = torch.max(output_softmax.data, 1)
        total += labels.size(0)
        correct += (predicted == labels).sum().item()

print(f"Test Accuracy: {100 * correct / total:.2f}%")
