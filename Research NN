import torch
import torch.nn as nn
import torch.nn.functional as F
import torch.optim as optim
import h5py
import numpy as np
import matplotlib.pyplot as plt
from torch.utils.data import TensorDataset, DataLoader

# Load MNIST data
MNIST_data = h5py.File('/Users/adikisieu/Downloads/MNISTdata.hdf5', 'r')
x_train = np.float32(MNIST_data['x_train'][:])
y_train = np.int64(MNIST_data['y_train'][:, 0])
x_test = np.float32(MNIST_data['x_test'][:])
y_test = np.int64(MNIST_data['y_test'][:, 0])
MNIST_data.close()

# Reshape and convert
x_train_tensor = torch.tensor(x_train).reshape(-1, 1, 28, 28)
y_train_tensor = torch.tensor(y_train)
x_test_tensor = torch.tensor(x_test).reshape(-1, 1, 28, 28)
y_test_tensor = torch.tensor(y_test)

# Define model
class Net(nn.Module):
    def __init__(self, input_size, hidden_size, output_size):
        super(Net, self).__init__()
        self.fc1 = nn.Linear(input_size, hidden_size)
        self.fc2 = nn.Linear(hidden_size, output_size)

        self.fc1.weight.data = torch.randn_like(self.fc1.weight) / torch.sqrt(torch.tensor(self.fc1.in_features, dtype=torch.float))
        self.fc2.weight.data = torch.randn_like(self.fc2.weight) / torch.sqrt(torch.tensor(self.fc2.in_features, dtype=torch.float))
        self.fc1.bias.data = torch.zeros_like(self.fc1.bias)
        self.fc2.bias.data = torch.zeros_like(self.fc2.bias)

    def forward(self, x):
        x = x.view(-1, 28*28)
        x = F.relu(self.fc1(x))
        return self.fc2(x)

# Init
input_size = 28 * 28
hidden_size = 500
output_size = 10
model = Net(input_size, hidden_size, output_size)

criterion = nn.CrossEntropyLoss(reduction='sum')  # <<< KEY CHANGE
optimizer = optim.SGD(model.parameters(), lr=0.001)

# Training loop 
num_iterations = 2000000
loss_dict = {}
test_dict = {}

for i in range(1, num_iterations + 1):
    idx = torch.randint(0, x_train_tensor.size(0), (1,)).item()
    inputs = x_train_tensor[idx].unsqueeze(0)  # shape: (1, 1, 28, 28)
    label = y_train_tensor[idx].unsqueeze(0)

    optimizer.zero_grad()
    outputs = model(inputs)  # Flatten happens inside model
    loss = criterion(outputs, label)
    loss.backward()
    optimizer.step()

    if i % 1000 == 0:
        with torch.no_grad():
            preds = model(x_test_tensor).argmax(1)
            acc = (preds == y_test_tensor).float().mean().item()

            logits = model(x_train_tensor)
            total_loss = criterion(logits, y_train_tensor).item()  # now exactly matches manual sum

            print(f"Trained for {i} times, loss = {total_loss:.4f}, test = {acc:.4f}")
            loss_dict[str(i)] = total_loss
            test_dict[str(i)] = acc

# Save weights
np.savetxt('Layer1', model.fc1.weight.detach().numpy())
np.savetxt('Layer2', model.fc2.weight.detach().numpy())

# Plot
plt.plot(loss_dict.keys(), loss_dict.values())
plt.ylabel('Loss function')
plt.xlabel('Number of iterations')
plt.xticks(rotation=60)
plt.title('Loss function w.r.t. number of iterations')
plt.show()

plt.plot(test_dict.keys(), test_dict.values())
plt.ylabel('Test Accuracy')
plt.xlabel('Number of iterations')
plt.xticks(rotation=60)
plt.title('Test accuracy w.r.t. number of iterations')
plt.show()
