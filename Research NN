import torch
import torch.nn as nn
import torch.nn.functional as F
import torch.optim as optim
import h5py
import numpy as np
import matplotlib.pyplot as plt
from torch.utils.data import TensorDataset, DataLoader

# Load MNIST data
MNIST_data = h5py.File('/Users/adikisieu/Downloads/MNISTdata.hdf5', 'r')
x_train = np.float32(MNIST_data['x_train'][:])
y_train = np.int64(MNIST_data['y_train'][:, 0])
x_test = np.float32(MNIST_data['x_test'][:])
y_test = np.int64(MNIST_data['y_test'][:, 0])
MNIST_data.close()

# Reshape and convert
x_train_tensor = torch.tensor(x_train).reshape(-1, 1, 28, 28)
y_train_tensor = torch.tensor(y_train)
x_test_tensor = torch.tensor(x_test).reshape(-1, 1, 28, 28)
y_test_tensor = torch.tensor(y_test)

# Define model
class Net(nn.Module):
    def __init__(self, input_size, hidden_size, output_size):
        super(Net, self).__init__()
        self.fc1 = nn.Linear(input_size, hidden_size)
        self.fc2 = nn.Linear(hidden_size, output_size)

        self.fc1.weight.data = torch.randn_like(self.fc1.weight) / torch.sqrt(torch.tensor(self.fc1.in_features, dtype=torch.float))
        self.fc2.weight.data = torch.randn_like(self.fc2.weight) / torch.sqrt(torch.tensor(self.fc2.in_features, dtype=torch.float))
        self.fc1.bias.data = torch.zeros_like(self.fc1.bias)
        self.fc2.bias.data = torch.zeros_like(self.fc2.bias)

    def forward(self, x):
        x = x.view(-1, 28*28)
        x = F.relu(self.fc1(x))
        return self.fc2(x)

# Init
input_size = 28 * 28
hidden_size = 500
output_size = 10
num_iterations = 2000000

# Store results across runs
all_losses = []
all_accuracies = []

for run in range(16):
    print(f"\n--- Run {run + 1} ---")

    model = Net(input_size, hidden_size, output_size)
    criterion = nn.CrossEntropyLoss(reduction='sum')
    optimizer = optim.SGD(model.parameters(), lr=0.001)

    loss_dict = {}
    test_dict = {}

    for i in range(1, num_iterations + 1):
        idx = torch.randint(0, x_train_tensor.size(0), (1,)).item()
        inputs = x_train_tensor[idx].unsqueeze(0)
        label = y_train_tensor[idx].unsqueeze(0)

        optimizer.zero_grad()
        outputs = model(inputs)
        loss = criterion(outputs, label)
        loss.backward()
        optimizer.step()

        if i % 1000 == 0:
            with torch.no_grad():
                preds = model(x_test_tensor).argmax(1)
                acc = (preds == y_test_tensor).float().mean().item()

                logits = model(x_train_tensor)
                total_loss = criterion(logits, y_train_tensor).item()

                print(f"Trained for {i} times, loss = {total_loss:.4f}, test = {acc:.4f}")
                loss_dict[str(i)] = total_loss
                test_dict[str(i)] = acc

    all_losses.append(list(loss_dict.values()))
    all_accuracies.append(list(test_dict.values()))

    # Print weights in your preferred format
    print(f"\n--- Weights after Run {run + 1} ---\n")
    for name, param in model.named_parameters():
        if param.requires_grad:
            print(f"{name} shape: {param.shape}")
            data = param.data.cpu().numpy()
            print(data[:5, :5] if data.ndim == 2 else data[:5])
            print()

# Overlapping loss curves
epochs = list(range(1000, num_iterations + 1, 1000))

plt.figure()
for losses in all_losses:
    plt.plot(epochs, losses, alpha=0.6)
plt.ylabel('Loss')
plt.xlabel('Iterations')
plt.title('Loss over 16 Runs')
plt.grid(True)
plt.show()

# overlapping accuracy curves
plt.figure()
for accs in all_accuracies:
    plt.plot(epochs, accs, alpha=0.6)
plt.ylabel('Accuracy')
plt.xlabel('Iterations')
plt.title('Accuracy over 16 Runs')
plt.grid(True)
plt.show()

loss_array = np.array(all_losses)
acc_array = np.array(all_accuracies)

# Mean & std across runs at each epoch
mean_loss = loss_array.mean(axis=0)
std_loss = loss_array.std(axis=0)
mean_acc = acc_array.mean(axis=0)
std_acc = acc_array.std(axis=0)

print("\n--- Final Epoch Statistics ---")
print(f"Loss:  mean = {mean_loss[-1]:.4f}, std = {std_loss[-1]:.4f}")
print(f"Acc:   mean = {mean_acc[-1]:.4f}, std = {std_acc[-1]:.4f}")
