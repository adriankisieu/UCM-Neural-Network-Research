import numpy as np
import torch
import torch.nn as nn
import torch.nn.functional as F
import torch.optim as optim
import h5py
import matplotlib.pyplot as plt
from torch.utils.data import TensorDataset, DataLoader, random_split
from numpy import loadtxt
import random
import copy

# ------- CONFIG -------
RUNS = 16
EPOCHS = 100
BATCH_SIZE = 600
EPOCH_START, EPOCH_END = 15, 50
LR = 0.001
SEED = 42
dev = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# ------- REPRODUCIBILITY -------
torch.manual_seed(SEED)
np.random.seed(SEED)
random.seed(SEED)

# ------- MODEL -------
class Net(nn.Module):
    def __init__(self):
        super().__init__()
        self.fc1 = nn.Linear(28 * 28, 500)
        self.fc2 = nn.Linear(500, 10)
        self._init_weights()

    def _init_weights(self):
        # NUMPY-STYLE INITIALIZATION (MATCHES YOUR ORIGINAL MODEL)
        for layer in self.modules():
            if isinstance(layer, nn.Linear):
                layer.weight.data = torch.randn_like(layer.weight) / np.sqrt(layer.in_features)
                layer.bias.data.zero_()

    def forward(self, x):
        x = x.view(-1, 28 * 28)
        x = F.relu(self.fc1(x))
        return self.fc2(x)

# ------- ADJUSTMENT: MAP TO DEVICE CONDUCTANCES (SIGNED NEAREST NEIGHBOR) -------
def map_signed_nearest(weights_np, device_vals_np):
    dv = np.sort(device_vals_np)
    w = weights_np.ravel()
    sign = np.sign(w)
    pos = np.clip(np.searchsorted(dv, np.abs(w)), 1, len(dv) - 1)
    left, right = dv[pos - 1], dv[pos]
    choose_right = (np.abs(right - np.abs(w)) < np.abs(left - np.abs(w)))
    mapped = np.where(choose_right, right, left) * sign
    return mapped.reshape(weights_np.shape)

# ------- ONE RUN -------
def run_once(bs):
    # LOAD MNIST
    with h5py.File('/Users/adikisieu/Downloads/MNISTdata.hdf5', 'r') as f:
        x_train = np.float32(f['x_train'][:])
        y_train = np.int64(f['y_train'][:, 0])
        x_test  = np.float32(f['x_test'][:])
        y_test  = np.int64(f['y_test'][:, 0])

    x_all = torch.tensor(np.concatenate([x_train, x_test]), dtype=torch.float32).reshape(-1, 1, 28, 28)
    y_all = torch.tensor(np.concatenate([y_train, y_test]), dtype=torch.long)
    full_ds = TensorDataset(x_all, y_all)
    n_train = int(0.8 * len(full_ds))
    train_ds, test_ds = random_split(full_ds, [n_train, len(full_ds) - n_train], generator=torch.Generator().manual_seed(SEED))
    train_loader = DataLoader(train_ds, batch_size=bs, shuffle=True, generator=torch.Generator().manual_seed(SEED))

    x_test_t, y_test_t = zip(*test_ds)
    x_test_t = torch.stack(x_test_t).to(dev)
    y_test_t = torch.tensor(y_test_t).to(dev)

    # ------- ADJUSTMENT: LOAD REAL DEVICE CONDUCTANCES -------
    device_vals = loadtxt('New Conductance.txt', dtype=float)
    print(f"Device conductances loaded: min={device_vals.min():.6f}, max={device_vals.max():.6f}")

    # ------- CREATE IDENTICAL RANDOM START FOR BOTH MODELS -------
    base_init = Net().to(dev)
    model_base = copy.deepcopy(base_init)
    model_adj  = copy.deepcopy(base_init)

    # ------- ADJUSTMENT: MAP BASE INIT TO DEVICE CONDUCTANCES (QUANTIZATION STEP) -------
    fc1 = model_adj.fc1.weight.detach().cpu().numpy()
    fc2 = model_adj.fc2.weight.detach().cpu().numpy()
    D1 = map_signed_nearest(fc1, device_vals)   # MAP LAYER 1 TO NEAREST CONDUCTANCE
    D2 = map_signed_nearest(fc2, device_vals)   # MAP LAYER 2 TO NEAREST CONDUCTANCE
    # NOTE: NO RESCALING — THESE ARE RAW DEVICE VALUES (TRUE HARDWARE LIMITATION)
    model_adj.fc1.weight.data = torch.tensor(D1, dtype=torch.float32, device=dev)
    model_adj.fc2.weight.data = torch.tensor(D2, dtype=torch.float32, device=dev)

    # ------- DEFINE LOSS/OPT FOR BOTH MODELS -------
    crit = nn.CrossEntropyLoss(reduction='sum')
    opt_base = optim.SGD(model_base.parameters(), lr=LR)
    opt_adj  = optim.SGD(model_adj.parameters(), lr=LR)

    base_losses, base_accs, adj_losses, adj_accs = [], [], [], []

    # ------- TRAIN BOTH MODELS INDEPENDENTLY -------
    for epoch in range(1, EPOCHS + 1):
        model_base.train()
        model_adj.train()
        for xb, yb in train_loader:
            xb, yb = xb.to(dev), yb.to(dev)

            # BASELINE UPDATE (FULL-PRECISION CONTINUOUS WEIGHTS)
            opt_base.zero_grad()
            loss_b = crit(model_base(xb), yb)
            loss_b.backward()
            opt_base.step()

            # ------- ADJUSTMENT UPDATE (FINITE CONDUCTANCE WEIGHTS) -------
            opt_adj.zero_grad()
            loss_a = crit(model_adj(xb), yb)
            loss_a.backward()
            opt_adj.step()

        # ------- EVALUATE BOTH MODELS -------
        model_base.eval()
        model_adj.eval()
        with torch.no_grad():
            out_b = model_base(x_test_t)
            out_a = model_adj(x_test_t)
            base_acc = (out_b.argmax(1) == y_test_t).float().mean().item()
            adj_acc  = (out_a.argmax(1) == y_test_t).float().mean().item()
            base_loss = crit(out_b, y_test_t).item()
            adj_loss  = crit(out_a, y_test_t).item()

        base_losses.append(base_loss); base_accs.append(base_acc)
        adj_losses.append(adj_loss);   adj_accs.append(adj_acc)

        print(f"Epoch {epoch:02d} | Base acc={base_acc:.4f} loss={base_loss:.2f} | "
              f"ADJ acc={adj_acc:.4f} loss={adj_loss:.2f}  <-- FINITE DEVICE MAPPED MODEL")

    return np.array(base_losses), np.array(base_accs), np.array(adj_losses), np.array(adj_accs)

# ------- MAIN -------
def main():
    all_base_losses, all_base_accs, all_adj_losses, all_adj_accs = [], [], [], []
    for run in range(RUNS):
        print(f"\n=== Run {run + 1} ===")
        bL, bA, aL, aA = run_once(BATCH_SIZE)
        all_base_losses.append(bL); all_base_accs.append(bA)
        all_adj_losses.append(aL);  all_adj_accs.append(aA)

    epochs = np.arange(EPOCH_START, EPOCH_END + 1)

    # ------- COMPARE BASELINE VS ADJUSTED PERFORMANCE -------
    plt.figure()
    for i in range(RUNS):
        plt.plot(epochs, all_base_accs[i][EPOCH_START-1:EPOCH_END], '--', label=f'Base Run {i+1}')
        plt.plot(epochs, all_adj_accs[i][EPOCH_START-1:EPOCH_END], label=f'ADJ Run {i+1} (DEVICE)')
    plt.xlabel('Epoch'); plt.ylabel('Accuracy')
    plt.title('BASELINE (CONTINUOUS) VS ADJUSTED (FINITE DEVICE)')
    plt.ylim(0.95, 0.985)
    plt.legend(); plt.savefig('adj_vs_base_device.png', dpi=300, bbox_inches='tight'); plt.show()

    print("\n✅ DONE. ADJUSTED MODEL USES TRUE DEVICE-CONSTRAINED CONDUCTANCES (NO RESCALING).")

if __name__ == "__main__":
    main()
